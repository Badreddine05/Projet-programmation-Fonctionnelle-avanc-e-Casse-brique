opam-version: "2.0"
name: "rebound"
version: "1.0.0"
synopsis: "Deterministic OCaml breakout with a browser renderer"
maintainer: "Badreddine Channoufi"
authors: "Badreddine Channoufi"
homepage: "https://github.com/Badreddine05/Projet-programmation-Fonctionnelle-avanc-e-Casse-brique"
bug-reports: "https://github.com/Badreddine05/Projet-programmation-Fonctionnelle-avanc-e-Casse-brique/issues"
depends: [
  "ocaml" {= "5.3.0"}
  "dune" {= "3.20.2"}
  "js_of_ocaml" {= "6.2.0"}
  "js_of_ocaml-compiler" {= "6.2.0"}
]
build: [
  ["dune" "build" "--profile" "release"]
  ["dune" "runtest"] {with-test}
]
